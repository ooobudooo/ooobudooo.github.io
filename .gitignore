# =====================================================================================
# Git 忽略规则（按用途分组；注意 .gitignore 不支持行尾注释，注释必须独占一行）
# =====================================================================================

# ---------- 操作系统 / 编辑器临时文件 ----------
.DS_Store
Thumbs.db

# ---------- 构建产物与缓存（每次 hexo generate 都会重新生成）----------
# 构建输出目录，发布时由 hexo-deployer-git 推送到 main 分支
public/
# Hexo 构建缓存，删除后会重新扫描 source/
db.json
# hexo-deployer-git 的临时部署仓库（.deploy_git）
.deploy*/
# 运行日志
*.log

# ---------- 依赖 ----------
# 由 package-lock.json 锁定版本，可用 npm ci 还原
node_modules/

# ---------- 主题 ----------
# 主题只认 npm 依赖 hexo-theme-keep（版本锁定在 package-lock.json）。
# themes/ 下的本地克隆仅供临时调试，不入库；否则会与 npm 包重复，
# 或在没有 .gitmodules 的情况下退化成残缺的 submodule 引用。
themes/*
!themes/.gitkeep

# ---------- 本地工作区数据 ----------
# WorkBuddy 的记忆/工作区数据，绝不入库。
# 历史教训：曾因缺少此规则，hexo deploy 的 git 操作逃逸到父仓库，
# 把 .workbuddy 提交进 master 并强推到 main，导致站点损坏。
.workbuddy/
